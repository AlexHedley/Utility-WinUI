<Window
    x:Class="UtilityWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Utility">
    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneTitle="Utility"
        SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="Home" />
            <NavigationViewItemSeparator />
            <NavigationViewItemHeader Content="Text &amp; data" />
            <NavigationViewItem Content="HTML encoder" Tag="HTML encoder" />
            <NavigationViewItem Content="URL encoder" Tag="URL encoder" />
            <NavigationViewItem Content="HEX to RGB" Tag="HEX to RGB" />
            <NavigationViewItem Content="SQL IN builder" Tag="SQL IN builder" />
            <NavigationViewItem Content="GUID generator" Tag="GUID generator" />
            <NavigationViewItem Content="JSON formatter" Tag="JSON formatter" />
            <NavigationViewItem Content="XML formatter" Tag="XML formatter" />
            <NavigationViewItem Content="SQL formatter" Tag="SQL formatter" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
